{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "vercel-public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/server/index.js"
    }
  },
  "rewrites": [{"source": "/(.*)", "destination": "/api"}]
}
